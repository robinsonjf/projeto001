---
---
<!-- Modal Overlay -->
<div id="notify-modal" class="fixed inset-0 z-[100] hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-sm" onclick="closeNotifyModal()"></div>
    
    <!-- Modal Content -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white p-8 rounded-md shadow-2xl">
        <!-- Close Button -->
        <button onclick="closeNotifyModal()" class="absolute top-6 right-6 w-8 h-8 flex items-center justify-center border border-stone-200 rounded-md text-stone-400 hover:text-stone-900 hover:border-stone-400 transition-colors">
            <iconify-icon icon="solar:close-linear" class="text-sm"></iconify-icon>
        </button>

        <div class="inline-block px-2 py-1 bg-stone-100 text-stone-500 text-[9px] font-mono tracking-[0.1em] uppercase rounded-sm mb-6">
            Alerta de Estoque
        </div>

        <h3 class="text-2xl font-display font-medium text-stone-900 mb-3">Avise-me quando chegar</h3>
        <p class="text-[13px] text-stone-500 font-light leading-relaxed mb-8">
            Preencha seus dados para receber uma notificação assim que o modelo <span id="notify-product-name" class="font-medium text-stone-900">Precision Ceramic White</span> estiver disponível.
        </p>

        <form class="flex flex-col gap-5" onsubmit="event.preventDefault(); closeNotifyModal();">
            <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-mono text-stone-400 uppercase tracking-[0.1em]">Nome Completo</label>
                <input type="text" placeholder="Seu nome completo" required class="w-full px-4 py-3 bg-[#fafaf9] border border-stone-200 rounded-sm text-sm text-stone-900 focus:outline-none focus:border-stone-900 focus:bg-white transition-colors placeholder:text-stone-300" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-mono text-stone-400 uppercase tracking-[0.1em]">Telefone / Whatsapp</label>
                <input type="tel" placeholder="(00) 00000-0000" required class="w-full px-4 py-3 bg-[#fafaf9] border border-stone-200 rounded-sm text-sm text-stone-900 focus:outline-none focus:border-stone-900 focus:bg-white transition-colors placeholder:text-stone-300" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-mono text-stone-400 uppercase tracking-[0.1em]">E-mail</label>
                <input type="email" placeholder="seu.email@exemplo.com" required class="w-full px-4 py-3 bg-[#fafaf9] border border-stone-200 rounded-sm text-sm text-stone-900 focus:outline-none focus:border-stone-900 focus:bg-white transition-colors placeholder:text-stone-300" />
            </div>

            <button type="submit" class="w-full py-4 mt-2 bg-[#1a1a1a] hover:bg-black text-white text-[11px] font-mono uppercase tracking-[0.2em] rounded-sm transition-colors shadow-md">
                Cadastrar Notificação
            </button>
        </form>
    </div>
</div>

<script is:inline>
    function openNotifyModal(productName) {
        if (productName) {
            const nameEl = document.getElementById('notify-product-name');
            if (nameEl) nameEl.textContent = productName;
        }
        document.getElementById('notify-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeNotifyModal() {
        document.getElementById('notify-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    // Assign to window to be accessible from any page
    window.openNotifyModal = openNotifyModal;
    window.closeNotifyModal = closeNotifyModal;
</script>
