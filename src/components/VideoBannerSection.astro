---
interface Props {
  videoSrc?: string;
}

const { videoSrc = "/assets/raw_files/video.mp4" } = Astro.props;
---
<section class="relative z-20 w-full bg-black overflow-hidden h-[150px] md:h-[180px]">
  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    class="w-full h-full object-cover"
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
</section>
