---
interface SpecItem {
  label: string;
  value: string;
}

interface Props {
  badge?: string;
  title?: string;
  description?: string;
  specs?: SpecItem[];
}

const {
  badge = "• SPECIFICATIONS",
  title = "Precision Series 6061",
  description = "A Precision Series 6061 é a evolução máxima dos instrumentos de escrita. Desenvolvida e usinada integralmente a partir de ligas aeroespaciais para proporcionar máxima precisão em cada traço.",
  specs = [
    { label: "COMPRIMENTO", value: "142 mm" },
    { label: "DIÂMETRO", value: "9.5 mm" },
    { label: "PESO TOTAL", value: "14 g" },
    { label: "ESFERA DA PONTA", value: "0.3 mm" },
    { label: "AUTONOMIA REFIL", value: "2.500 m" },
    { label: "CENTRO DE GRAVIDADE", value: "52%" },
    { label: "USINAGEM CNC", value: "5 eixos" },
    { label: "LIGA ALUMÍNIO", value: "6061-T6" },
    { label: "TEXTURA MICRO-GRIP", value: "Ra 0.8µm" },
    { label: "TOLERÂNCIA MECÂNICA", value: "±0.01 mm" },
    { label: "GARANTIA CHASSI", value: "Vitalícia" }
  ]
} = Astro.props;
---
<section class="relative z-20 bg-black text-white py-20 px-6 md:px-24 border-t border-stone-900">
  <div class="max-w-[900px] mx-auto">
    <!-- Summary Header -->
    <div class="mb-6 text-left">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-stone-400 mb-3">
        {badge}
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
        {title}
      </h2>
      <p class="text-stone-400 text-sm md:text-base leading-relaxed max-w-2xl font-light">
        {description}
      </p>
    </div>

    <!-- Specs List -->
    <div class="font-mono divide-y divide-white/5 border-t border-b border-white/5">
      {specs.map((item) => (
        <div class="flex justify-between items-center py-1 px-4 hover:bg-stone-950/60 transition-colors">
          <span class="text-xs tracking-[0.2em] text-stone-400 font-medium">
            {item.label}
          </span>
          <span class="text-sm md:text-base text-stone-100 font-medium tracking-wider">
            {item.value}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
