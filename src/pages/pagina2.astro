import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
---

<Layout>
    <main class="flex flex-col items-start min-h-[75vh] w-full px-6 py-20 md:py-28 max-w-7xl mx-auto">
        <!-- Header da Página -->
        <div class="inline-flex items-center mb-4 px-3 py-1 bg-stone-200/60 rounded border border-stone-300/80 text-[11px] font-mono text-stone-700 tracking-widest uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-800 mr-2"></span>
            Catálogo Oficial
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-medium text-stone-900 mb-4 tracking-tight text-left">
            Coleção de Precisão
        </h1>
        <p class="text-stone-600 font-light max-w-2xl text-sm md:text-base leading-relaxed text-left mb-16">
            Conheça as variantes exclusivas desenvolvidas em liga aeroespacial, latão artesanal e cerâmica zircônia. Engenharia de ponta a serviço da escrita.
        </p>

        <!-- Grid do Catálogo -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 w-full">
            {products.map((pen) => (
                <div class="group relative bg-white rounded-md border border-stone-300/80 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden">
                    <!-- Área da Imagem com Badges -->
                    <a href={`${cleanBase}/pagina3/${pen.id}/`} class="w-full aspect-[4/3] bg-stone-200 relative overflow-hidden border-b border-stone-200 block">
                        <!-- Badges Sobrepostos -->
                        <div class="absolute top-3 left-3 z-10">
                            <span class="px-2.5 py-1 bg-stone-900 text-white text-[10px] font-mono font-medium tracking-wider uppercase rounded-sm">
                                {pen.tagLeft}
                            </span>
                        </div>
                        <div class="absolute top-3 right-3 z-10">
                            <span class="px-2.5 py-1 bg-stone-100/90 backdrop-blur-sm text-stone-600 border border-stone-300/70 text-[10px] font-mono font-medium tracking-wider uppercase rounded-sm">
                                {pen.tagRight}
                            </span>
                        </div>
                        <img src={`${cleanBase}${pen.mainImage}`} alt={pen.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </a>
                    
                    <!-- Conteúdo do Card -->
                    <div class="p-6 flex flex-col flex-grow">
                        <a href={`${cleanBase}/pagina3/${pen.id}/`} class="hover:underline">
                            <h3 class="text-xl font-display font-medium text-stone-900 mb-2 tracking-tight">{pen.name}</h3>
                        </a>
                        <p class="text-stone-500 text-xs font-light leading-relaxed mb-6 flex-grow">
                            {pen.desc}
                        </p>
                        
                        <!-- Especificações Técnicas -->
                        <div class="grid grid-cols-3 gap-2 py-3 border-t border-b border-stone-100 mb-6">
                            <div>
                                <span class="block text-[10px] text-stone-400 font-mono uppercase tracking-wider">Pena</span>
                                <span class="font-medium text-stone-800 text-[11px] truncate block" title={pen.cardSpecs.pena}>{pen.cardSpecs.pena}</span>
                            </div>
                            <div>
                                <span class="block text-[10px] text-stone-400 font-mono uppercase tracking-wider">Material</span>
                                <span class="font-medium text-stone-800 text-[11px] truncate block" title={pen.cardSpecs.material}>{pen.cardSpecs.material}</span>
                            </div>
                            <div>
                                <span class="block text-[10px] text-stone-400 font-mono uppercase tracking-wider">Recarga</span>
                                <span class="font-medium text-stone-800 text-[11px] truncate block" title={pen.cardSpecs.recarga}>{pen.cardSpecs.recarga}</span>
                            </div>
                        </div>

                        <!-- Botão AVISE-ME de Largura Total -->
                        <a href={`${cleanBase}/pagina3/${pen.id}/`} class="w-full py-3 bg-stone-900 hover:bg-stone-800 text-white text-xs font-mono uppercase tracking-widest rounded transition-colors flex items-center justify-center gap-2 group-hover:bg-black">
                            <iconify-icon icon="solar:bell-linear" class="text-sm"></iconify-icon>
                            AVISE-ME
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </main>
</Layout>
