---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <main class="container mx-auto px-6 py-32 min-h-screen">
        <h1 class="text-4xl font-display font-bold text-stone-900">Página em Branco</h1>
        <p class="mt-4 text-stone-600">Esta é a sua nova página. Você pode adicionar conteúdo aqui.</p>
    </main>
    <Footer />
</Layout>
