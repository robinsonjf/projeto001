---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const defaultProduct = products[0];
---

<Layout>
    <main class="min-h-screen w-full px-6 py-20 md:py-28 max-w-7xl mx-auto">
        <!-- Navegação Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-mono text-stone-500 mb-8 uppercase tracking-widest">
            <a href={`${cleanBase}/`} class="hover:text-stone-900 transition-colors">Início</a>
            <span>/</span>
            <a href={`${cleanBase}/pagina2/`} class="hover:text-stone-900 transition-colors">Catálogo</a>
            <span>/</span>
            <span id="breadcrumb-product-name" class="text-stone-900 font-medium">{defaultProduct.name}</span>
        </nav>

        <!-- Seção Principal de Detalhes -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
            
            <!-- Coluna Esquerda: Galeria de Imagens -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <!-- Imagem Principal -->
                <div class="w-full aspect-[4/3] bg-stone-200 rounded-lg overflow-hidden border border-stone-300/80 shadow-sm relative group">
                    <span id="product-status-badge" class="absolute top-4 left-4 z-10 px-3 py-1 bg-stone-900 text-white text-[10px] font-mono tracking-widest uppercase rounded">
                        {defaultProduct.status}
                    </span>
                    <img id="main-product-img" src={`${cleanBase}${defaultProduct.mainImage}`} alt={defaultProduct.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                </div>

                <!-- Miniaturas -->
                <div id="gallery-container" class="grid grid-cols-3 gap-4">
                    {defaultProduct.gallery.map((imgUrl, index) => (
                        <button 
                            class="aspect-[4/3] rounded border border-stone-300/80 overflow-hidden bg-stone-200 hover:border-stone-900 transition-colors focus:ring-2 focus:ring-stone-900 focus:outline-none"
                            onclick={`document.getElementById('main-product-img').src='${cleanBase}${imgUrl}'`}
                        >
                            <img src={`${cleanBase}${imgUrl}`} alt={`Variação ${index + 1}`} class="w-full h-full object-cover" />
                        </button>
                    ))}
                </div>
            </div>

            <!-- Coluna Direita: Informações & Ação -->
            <div class="lg:col-span-5 flex flex-col items-start">
                <div class="inline-flex items-center mb-3 px-3 py-1 bg-stone-200/70 rounded text-[11px] font-mono text-stone-700 tracking-widest uppercase border border-stone-300/80">
                    Série Precision
                </div>
                
                <h1 id="product-name" class="text-3xl md:text-4xl lg:text-5xl font-display font-medium text-stone-900 tracking-tight mb-2">
                    {defaultProduct.name}
                </h1>
                <p id="product-subtitle" class="text-stone-500 font-mono text-xs uppercase tracking-wider mb-6">
                    {defaultProduct.subtitle}
                </p>

                <p id="product-desc" class="text-stone-600 font-light text-sm md:text-base leading-relaxed mb-8 border-b border-stone-200 pb-8">
                    {defaultProduct.desc}
                </p>

                <!-- Especificações Rápidas -->
                <div class="w-full mb-8">
                    <h3 class="text-xs font-mono uppercase tracking-widest text-stone-400 mb-4">Especificações Chave</h3>
                    <div id="quick-specs-container" class="grid grid-cols-2 gap-y-3 gap-x-4">
                        {defaultProduct.specs.slice(0, 4).map((spec) => (
                            <div>
                                <span class="block text-[10px] font-mono text-stone-400 uppercase tracking-wider">{spec.label}</span>
                                <span class="text-xs font-medium text-stone-800">{spec.value}</span>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Formulário / Botão AVISE-ME -->
                <div class="w-full bg-stone-100 p-6 rounded-lg border border-stone-300/80 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-mono text-stone-500 uppercase tracking-wider">Status de Estoque</span>
                        <span class="inline-flex items-center text-xs font-mono font-medium text-amber-700 bg-amber-100 px-2.5 py-0.5 rounded-full border border-amber-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                            Fila de Espera
                        </span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="email-notify" class="text-xs font-mono text-stone-600">Receba a notificação do próximo lote:</label>
                        <input 
                            type="email" 
                            id="email-notify" 
                            placeholder="seu.email@exemplo.com" 
                            class="w-full px-4 py-3 bg-white border border-stone-300 rounded text-xs font-mono focus:outline-none focus:border-stone-900 transition-colors"
                        />
                    </div>

                    <button class="w-full py-4 bg-stone-900 hover:bg-black text-white text-xs font-mono uppercase tracking-widest rounded transition-colors flex items-center justify-center gap-2 shadow-md">
                        <iconify-icon icon="solar:bell-linear" class="text-base"></iconify-icon>
                        AVISE-ME QUANDO DISPONÍVEL
                    </button>
                    <p class="text-[10px] text-stone-400 font-mono text-center">Prometemos não enviar spam. Notificação única por e-mail.</p>
                </div>

            </div>
        </div>

        <!-- Seção Inferior: Tabela Técnica Completa & Diferenciais -->
        <div class="border-t border-stone-200 pt-16">
            <h2 class="text-2xl font-display font-medium text-stone-900 mb-8">Ficha Técnica Detalhada</h2>
            
            <div id="full-specs-container" class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 mb-20">
                {defaultProduct.specs.map((spec) => (
                    <div class="flex items-center justify-between py-3 border-b border-stone-200/80">
                        <span class="text-xs font-mono text-stone-500 uppercase tracking-wider">{spec.label}</span>
                        <span class="text-xs font-medium text-stone-900">{spec.value}</span>
                    </div>
                ))}
            </div>

            <!-- Cards de Destaques da Engenharia -->
            <div id="highlights-container" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {defaultProduct.highlights.map((item) => (
                    <div class="bg-white p-6 rounded-lg border border-stone-300/80 shadow-sm flex flex-col gap-3">
                        <iconify-icon icon={item.icon} class="text-3xl text-stone-800"></iconify-icon>
                        <h4 class="text-lg font-display font-medium text-stone-900">{item.title}</h4>
                        <p class="text-xs text-stone-500 font-light leading-relaxed">{item.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </main>
</Layout>

<script is:inline define:vars={{ products, cleanBase }}>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const productId = urlParams.get('id');
        
        if (!productId) return;

        const product = products.find(p => p.id === productId);
        if (!product) return;

        // Atualizar textos e metadados
        const nameEl = document.getElementById('product-name');
        const breadcrumbEl = document.getElementById('breadcrumb-product-name');
        const subtitleEl = document.getElementById('product-subtitle');
        const descEl = document.getElementById('product-desc');
        const statusEl = document.getElementById('product-status-badge');
        const mainImgEl = document.getElementById('main-product-img');

        if (nameEl) nameEl.textContent = product.name;
        if (breadcrumbEl) breadcrumbEl.textContent = product.name;
        if (subtitleEl) subtitleEl.textContent = product.subtitle;
        if (descEl) descEl.textContent = product.desc;
        if (statusEl) statusEl.textContent = product.status;
        if (mainImgEl) {
            mainImgEl.src = cleanBase + product.mainImage;
            mainImgEl.alt = product.name;
        }

        // Atualizar Galeria
        const galleryContainer = document.getElementById('gallery-container');
        if (galleryContainer && product.gallery) {
            galleryContainer.innerHTML = product.gallery.map((imgUrl, idx) => `
                <button 
                    class="aspect-[4/3] rounded border border-stone-300/80 overflow-hidden bg-stone-200 hover:border-stone-900 transition-colors focus:ring-2 focus:ring-stone-900 focus:outline-none"
                    onclick="document.getElementById('main-product-img').src='${cleanBase}${imgUrl}'"
                >
                    <img src="${cleanBase}${imgUrl}" alt="Variação ${idx + 1}" class="w-full h-full object-cover" />
                </button>
            `).join('');
        }

        // Atualizar Especificações Rápidas
        const quickSpecsContainer = document.getElementById('quick-specs-container');
        if (quickSpecsContainer && product.specs) {
            quickSpecsContainer.innerHTML = product.specs.slice(0, 4).map(spec => `
                <div>
                    <span class="block text-[10px] font-mono text-stone-400 uppercase tracking-wider">${spec.label}</span>
                    <span class="text-xs font-medium text-stone-800">${spec.value}</span>
                </div>
            `).join('');
        }

        // Atualizar Ficha Técnica Completa
        const fullSpecsContainer = document.getElementById('full-specs-container');
        if (fullSpecsContainer && product.specs) {
            fullSpecsContainer.innerHTML = product.specs.map(spec => `
                <div class="flex items-center justify-between py-3 border-b border-stone-200/80">
                    <span class="text-xs font-mono text-stone-500 uppercase tracking-wider">${spec.label}</span>
                    <span class="text-xs font-medium text-stone-900">${spec.value}</span>
                </div>
            `).join('');
        }

        // Atualizar Highlights / Diferenciais
        const highlightsContainer = document.getElementById('highlights-container');
        if (highlightsContainer && product.highlights) {
            highlightsContainer.innerHTML = product.highlights.map(item => `
                <div class="bg-white p-6 rounded-lg border border-stone-300/80 shadow-sm flex flex-col gap-3">
                    <iconify-icon icon="${item.icon}" class="text-3xl text-stone-800"></iconify-icon>
                    <h4 class="text-lg font-display font-medium text-stone-900">${item.title}</h4>
                    <p class="text-xs text-stone-500 font-light leading-relaxed">${item.desc}</p>
                </div>
            `).join('');
        }
    });
</script>
