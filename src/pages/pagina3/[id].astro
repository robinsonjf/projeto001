---
import Layout from '../../layouts/Layout.astro';
import { products, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { id } = Astro.params;
const product = Astro.props.product || products.find(p => p.id === id) || products[0];

const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
---

<Layout>
    <main class="min-h-screen w-full px-6 pt-32 pb-20 max-w-7xl mx-auto bg-white">
        <!-- Navegação Breadcrumb -->
        <nav class="flex items-center gap-2 text-[10px] font-mono text-stone-400 mb-12 uppercase tracking-[0.2em]">
            <a href={`${cleanBase}/`} class="hover:text-stone-900 transition-colors">Início</a>
            <span>/</span>
            <a href={`${cleanBase}/pagina2/`} class="hover:text-stone-900 transition-colors">Catálogo</a>
            <span>/</span>
            <span class="text-stone-900">{product.name}</span>
        </nav>

        <!-- Seção Principal de Detalhes -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-24">
            
            <!-- Coluna Esquerda: Galeria de Imagens -->
            <div class="lg:col-span-7 flex flex-col gap-4">
                <!-- Imagem Principal -->
                <div class="w-full aspect-[4/3] bg-stone-100/50 rounded-sm overflow-hidden relative group">
                    <span class="absolute top-4 left-4 z-10 px-3 py-1 bg-[#1a1a1a] text-white text-[9px] font-mono tracking-[0.1em] uppercase rounded-sm">
                        {product.tagLeft}
                    </span>
                    <span class="absolute top-4 right-4 z-10 px-3 py-1 bg-white border border-stone-200 text-stone-500 text-[9px] font-mono tracking-[0.1em] uppercase rounded-sm shadow-sm">
                        {product.tagRight}
                    </span>
                    <img id="main-product-img" src={`${cleanBase}${product.mainImage}`} alt={product.name} class="w-full h-full object-cover" />
                </div>

                <!-- Miniaturas -->
                <div class="flex gap-4" id="gallery-container">
                    {[
                        { scale: 'scale-100', rotate: 'rotate-0', fit: 'object-cover' },
                        { scale: 'scale-100', rotate: 'rotate-90', fit: 'object-cover' },
                        { scale: 'scale-100', rotate: '-rotate-90', fit: 'object-cover' }
                    ].map((style, index) => (
                        <button 
                            class={`thumb-btn w-20 aspect-square rounded-sm border ${index === 0 ? 'border-stone-900' : 'border-stone-200'} overflow-hidden bg-stone-100 hover:border-stone-400 transition-colors focus:outline-none`}
                            data-target-class={`w-full h-full ${style.fit} transition-all duration-500 ${style.scale} ${style.rotate}`}
                        >
                            <img src={`${cleanBase}${product.mainImage}`} alt={`Ângulo ${index + 1}`} class={`w-full h-full ${style.fit} ${style.scale} ${style.rotate}`} />
                        </button>
                    ))}
                </div>

                <script>
                    const btns = document.querySelectorAll('.thumb-btn');
                    const mainImg = document.getElementById('main-product-img');
                    btns.forEach(btn => {
                        btn.addEventListener('click', () => {
                            btns.forEach(b => {
                                b.classList.remove('border-stone-900');
                                b.classList.add('border-stone-200');
                            });
                            btn.classList.remove('border-stone-200');
                            btn.classList.add('border-stone-900');
                            if(mainImg) mainImg.className = btn.dataset.targetClass;
                        });
                    });
                </script>
            </div>

            <!-- Coluna Direita: Informações & Ação -->
            <div class="lg:col-span-5 flex flex-col items-start pt-2">
                <div class="flex items-center gap-2 mb-4">
                    <span class="w-1 h-1 rounded-full bg-stone-800"></span>
                    <span class="text-[9px] font-mono text-stone-400 tracking-[0.2em] uppercase">Precisão & Engenharia</span>
                </div>
                
                <h1 class="text-3xl md:text-[2.5rem] font-display font-medium text-stone-900 tracking-tight mb-4">
                    {product.name}
                </h1>

                <p class="text-stone-500 font-light text-[13px] leading-relaxed mb-10 max-w-sm">
                    {product.desc}
                </p>

                <!-- Preço -->
                <div class="w-full mb-8 border-b border-stone-100 pb-6">
                    <div class="flex justify-between items-end mb-1">
                        <span class="text-[9px] font-mono text-stone-300 uppercase tracking-[0.2em]">Preço Exclusivo</span>
                        <span class="px-2 py-1 bg-stone-50 border border-stone-100 text-stone-400 text-[9px] font-mono tracking-[0.1em] uppercase rounded-sm">
                            Lote Futuro
                        </span>
                    </div>
                    <div class="text-2xl font-display font-medium text-stone-900">
                        {product.price === 'Sob Consulta' ? 'R$ 1.290,00' : product.price}
                    </div>
                </div>

                <!-- Especificações Rápidas -->
                <div class="w-full bg-[#fafaf9] border border-[#f5f5f4] p-5 rounded-sm mb-8">
                    <h3 class="text-[9px] font-mono uppercase tracking-[0.2em] text-stone-300 mb-4">Especificações Rápidas</h3>
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <span class="block text-[9px] font-mono text-stone-400 uppercase tracking-[0.1em] mb-1">Pena</span>
                            <span class="text-xs font-medium text-stone-800">{product.cardSpecs?.pena || 'Aço Inox M'}</span>
                        </div>
                        <div>
                            <span class="block text-[9px] font-mono text-stone-400 uppercase tracking-[0.1em] mb-1">Material</span>
                            <span class="text-xs font-medium text-stone-800">{product.cardSpecs?.material || 'Cerâmica Zircônia'}</span>
                        </div>
                        <div>
                            <span class="block text-[9px] font-mono text-stone-400 uppercase tracking-[0.1em] mb-1">Recarga</span>
                            <span class="text-xs font-medium text-stone-800">{product.cardSpecs?.recarga || 'Rollerball G2'}</span>
                        </div>
                    </div>
                </div>

                <!-- Seletor de Modelo -->
                <div class="w-full mb-8">
                    <h3 class="text-[9px] font-mono uppercase tracking-[0.2em] text-stone-300 mb-3">Selecione o Modelo</h3>
                    <div class="grid grid-cols-3 gap-2">
                        <div class="p-3 border border-stone-900 bg-[#111] rounded-sm flex flex-col justify-center">
                            <span class="text-[10px] font-medium text-white block mb-0.5 truncate">Titanium Stealth Minimal...</span>
                            <span class="text-[9px] text-stone-400">Esgotado</span>
                        </div>
                        <div class="p-3 border border-stone-200 bg-white rounded-sm flex flex-col justify-center">
                            <span class="text-[10px] font-medium text-stone-900 block mb-0.5 truncate">Precision Ceramic White</span>
                            <span class="text-[9px] text-stone-400">Em Breve</span>
                        </div>
                        <div class="p-3 border border-stone-200 bg-white opacity-60 rounded-sm flex flex-col justify-center">
                            <span class="text-[10px] font-medium text-stone-900 block mb-0.5 truncate">Obsidian Matte Black</span>
                            <span class="text-[9px] text-stone-400">Esgotado</span>
                        </div>
                    </div>
                </div>

                <!-- Botão AVISE-ME -->
                <button onclick={`openNotifyModal('${product.name}')`} class="w-full py-4 bg-[#0a0a0a] hover:bg-black text-white text-[11px] font-mono uppercase tracking-[0.2em] rounded-sm transition-colors flex items-center justify-center gap-2 mb-3">
                    <iconify-icon icon="solar:bell-linear" class="text-sm"></iconify-icon>
                    AVISE-ME
                </button>
                <p class="text-[9px] text-stone-400 font-mono text-center w-full">Cadastre-se para ser notificado assim que o estoque for renovado.</p>
            </div>
        </div>

        <!-- Seção Inferior: Especificações Técnicas -->
        <div class="border-t border-stone-200/60 pt-16 mt-20">
            <h3 class="text-[10px] font-mono text-stone-400 uppercase tracking-[0.2em] mb-2">Engenharia de Precisão</h3>
            <h2 class="text-[2rem] font-display font-medium text-stone-800 mb-12">Especificações Técnicas</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-20 gap-y-6">
                {product.specs.map((spec) => (
                    <div class="flex items-center justify-between pb-4 border-b border-stone-100">
                        <span class="text-[11px] font-mono text-stone-400 uppercase tracking-[0.1em]">{spec.label}</span>
                        <span class="text-[13px] font-medium text-stone-800">{spec.value}</span>
                    </div>
                ))}
            </div>
        </div>
    </main>
</Layout>

